diff --git a/src/llama-littlebit.cpp b/src/llama-littlebit.cpp
new file mode 100644
index 0000000..b822cfb
--- /dev/null
+++ b/src/llama-littlebit.cpp
@@ -0,0 +1,71 @@
+#include "llama-littlebit.h"
+
+#include <stdexcept>
+#include <string>
+
+ggml_tensor * llama_littlebit::new_proxy(const char * name, int64_t n_in, int64_t n_out, int64_t n_max) {
+    if (!ctx_proxy) {
+        n_proxy_max = n_max > 0 ? n_max : 1024;
+        ggml_init_params params = {
+            /*.mem_size   =*/ ggml_tensor_overhead() * (size_t) n_proxy_max,
+            /*.mem_buffer =*/ nullptr,
+            /*.no_alloc   =*/ true,
+        };
+        ctx_proxy.reset(ggml_init(params));
+        if (!ctx_proxy) {
+            throw std::runtime_error("littlebit: failed to create proxy context");
+        }
+    }
+    if ((int64_t) layers.size() >= n_proxy_max) {
+        throw std::runtime_error("littlebit: too many factorized layers");
+    }
+
+    // F32 so that the shape is always valid; the tensor is never allocated nor computed
+    ggml_tensor * t = ggml_new_tensor_2d(ctx_proxy.get(), GGML_TYPE_F32, n_in, n_out);
+    ggml_set_name(t, name);
+    return t;
+}
+
+size_t llama_littlebit::nbytes() const {
+    size_t n = 0;
+    for (const auto & it : layers) {
+        const auto & lb = it.second;
+        for (const ggml_tensor * t : { lb.v2, lb.v, lb.v2_r, lb.v_r, lb.u }) {
+            if (t) {
+                n += ggml_nbytes(t);
+            }
+        }
+    }
+    return n;
+}
+
+// latent activations h = V_b (v2 * x), zero-padded to r_pad
+static ggml_tensor * llama_littlebit_branch(
+        ggml_context * ctx,
+        ggml_tensor  * v2,
+        ggml_tensor  * v,
+        ggml_tensor  * x,
+        int64_t n_in, int64_t in_pad, int64_t r, int64_t r_pad) {
+    ggml_tensor * h = ggml_mul(ctx, x, v2);
+    if (in_pad > n_in) {
+        h = ggml_pad(ctx, h, (int) (in_pad - n_in), 0, 0, 0);
+    }
+    h = ggml_mul_mat(ctx, v, h); // [r, ...] (per-row scale v1*u2 is folded into the Q1_0 block scales)
+    if (r_pad > r) {
+        h = ggml_pad(ctx, h, (int) (r_pad - r), 0, 0, 0);
+    }
+    return h;
+}
+
+ggml_tensor * llama_littlebit_mul_mat(ggml_context * ctx, const llama_littlebit_linear & lb, ggml_tensor * x) {
+    GGML_ASSERT(x->ne[0] == lb.n_in);
+
+    ggml_tensor * h = llama_littlebit_branch(ctx, lb.v2, lb.v, x, lb.n_in, lb.in_pad, lb.r, lb.r_pad);
+    if (lb.residual()) {
+        ggml_tensor * h_r = llama_littlebit_branch(ctx, lb.v2_r, lb.v_r, x, lb.n_in, lb.in_pad, lb.r, lb.r_pad);
+        h = ggml_concat(ctx, h, h_r, 0); // [2*r_pad, ...] matches the [U | U_R] layout of lb.u
+    }
+
+    // y = U_b h, per-output-row scale u1 (and u1_R) folded into the Q1_0 block scales
+    return ggml_mul_mat(ctx, lb.u, h);
+}
diff --git a/src/llama-littlebit.h b/src/llama-littlebit.h
new file mode 100644
index 0000000..5dcbca4
--- /dev/null
+++ b/src/llama-littlebit.h
@@ -0,0 +1,78 @@
+#pragma once
+
+// LittleBit / LittleBit-2 factorized binary linear layers
+//   ref: https://github.com/SamsungLabs/LittleBit (arXiv:2506.13771, arXiv:2603.00042)
+//
+// A LittleBit linear layer replaces a dense weight W [out x in] with
+//
+//     y = u1 * ( U_b ( (v1*u2) * ( V_b ( v2 * x ) ) ) )            (+ an optional residual branch)
+//
+// where U_b [out x r] and V_b [r x in] are {-1,+1} matrices and u1, u2, v1, v2 are per-channel scales.
+//
+// In GGUF a LittleBit layer named `<base>.weight` is stored as (no dense `<base>.weight` tensor):
+//
+//   <base>.lb_v2    F32  [in]                 input channel scale v2
+//   <base>.lb_v     Q1_0 [in_pad, r]          sign(V), block scale d = v1*u2 (per latent row)
+//   <base>.lb_v2_r  F32  [in]                 (residual only)
+//   <base>.lb_v_r   Q1_0 [in_pad, r]          (residual only)
+//   <base>.lb_u     Q1_0 [n_br*r_pad, out]    [sign(U) | sign(U_R)], block scale d = u1 (resp. u1_R) per output row
+//
+// in_pad and r_pad are rounded up to the Q1_0 block size (128). The padded activations are zero, so the
+// padding is exact. The factors may also be stored as F16/F32, which avoids the 8-bit activation
+// quantization that Q1_0 matmuls perform on the CPU (used as a reference in tests).
+
+#include "ggml.h"
+
+#include <cstdint>
+#include <memory>
+#include <unordered_map>
+
+struct llama_littlebit_linear {
+    ggml_tensor * v2   = nullptr; // [in]
+    ggml_tensor * v    = nullptr; // [in_pad, r]
+    ggml_tensor * v2_r = nullptr; // [in]           (residual)
+    ggml_tensor * v_r  = nullptr; // [in_pad, r]    (residual)
+    ggml_tensor * u    = nullptr; // [n_br*r_pad, out]
+
+    int64_t n_in   = 0;
+    int64_t n_out  = 0;
+    int64_t in_pad = 0;
+    int64_t r      = 0;
+    int64_t r_pad  = 0;
+
+    bool residual() const { return v_r != nullptr; }
+};
+
+struct llama_littlebit_ctx_deleter {
+    void operator()(ggml_context * ctx) const { if (ctx) { ggml_free(ctx); } }
+};
+
+struct llama_littlebit {
+    // dense-weight proxy tensor -> factorized layer
+    // the proxy carries the logical shape [in, out] of the replaced weight but owns no data;
+    // build_lora_mm() dispatches on it and never feeds it to a real ggml op
+    std::unordered_map<const ggml_tensor *, llama_littlebit_linear> layers;
+
+    // metadata-only context that owns the proxy tensors
+    std::unique_ptr<ggml_context, llama_littlebit_ctx_deleter> ctx_proxy;
+    int64_t n_proxy_max = 0;
+
+    bool empty() const { return layers.empty(); }
+
+    const llama_littlebit_linear * find(const ggml_tensor * w) const {
+        if (layers.empty() || w == nullptr) {
+            return nullptr;
+        }
+        const auto it = layers.find(w);
+        return it == layers.end() ? nullptr : &it->second;
+    }
+
+    // create a data-less proxy tensor standing in for the dense weight `name` of shape [n_in, n_out]
+    ggml_tensor * new_proxy(const char * name, int64_t n_in, int64_t n_out, int64_t n_max);
+
+    // total bytes used by the factorized weights (for logging)
+    size_t nbytes() const;
+};
+
+// y = W x for a LittleBit layer; x: [n_in, ...] -> y: [n_out, ...]
+ggml_tensor * llama_littlebit_mul_mat(ggml_context * ctx, const llama_littlebit_linear & lb, ggml_tensor * x);
