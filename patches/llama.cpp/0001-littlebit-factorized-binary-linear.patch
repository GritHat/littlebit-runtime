diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index dbc91a1..3cf8468 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -29,2 +29,3 @@
 #include <cassert>
+#include <cinttypes>
 #include <cfloat>
@@ -2148,2 +2149,7 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
 
+    if (!littlebit.empty()) {
+        LLAMA_LOG_INFO("%s: LittleBit: %zu factorized binary linear layers, %.2f MiB\n",
+                __func__, littlebit.layers.size(), littlebit.nbytes()/1024.0/1024.0);
+    }
+
     return true;
@@ -2488,5 +2494,88 @@ ggml_tensor * llama_model_base::create_tensor(llama_model_loader & ml, const LLM
     }
-    return ml.create_tensor(
-        hparams, &pimpl->cpu_buft_list, pimpl->dev_input.buft_list, pimpl->dev_output.buft_list, buft_list_layer,
-        tn, ne, flags);
+    auto create = [&](const LLM_TN_IMPL & tn_, const std::initializer_list<int64_t> & ne_, int flags_) {
+        return ml.create_tensor(
+            hparams, &pimpl->cpu_buft_list, pimpl->dev_input.buft_list, pimpl->dev_output.buft_list, buft_list_layer,
+            tn_, ne_, flags_);
+    };
+
+    // LittleBit: a dense 2D weight may be stored as binary latent factors (see llama-littlebit.h)
+    if (tn.suffix != nullptr && strcmp(tn.suffix, "weight") == 0 && ne.size() == 2) {
+        const std::string base = LLM_TN_IMPL(tn.arch, tn.tensor, nullptr, tn.bid, tn.xid).str();
+        const ggml_tensor * meta_u = ml.get_tensor_meta((base + ".lb_u").c_str());
+        if (meta_u != nullptr) {
+            // the graph of these architectures only uses layer weights through build_lora_mm()
+            switch (arch) {
+                case LLM_ARCH_LLAMA:
+                case LLM_ARCH_QWEN2:
+                case LLM_ARCH_QWEN3:
+                case LLM_ARCH_GEMMA2:
+                case LLM_ARCH_GEMMA3:
+                    break;
+                default:
+                    throw std::runtime_error(format("littlebit: architecture '%s' is not supported", llm_arch_name(arch)));
+            }
+
+            uint32_t version = 0;
+            ml.get_key(std::string("littlebit.version"), version);
+            if (version != 1) {
+                throw std::runtime_error(format("littlebit: unsupported format version %u", version));
+            }
+
+            if (ml.get_tensor_meta(tn.str().c_str()) != nullptr) {
+                throw std::runtime_error(format("littlebit: tensor '%s' has both dense and factorized weights", tn.str().c_str()));
+            }
+            const int64_t n_in  = ne.begin()[0];
+            const int64_t n_out = ne.begin()[1];
+
+            const ggml_tensor * meta_v  = ml.require_tensor_meta(base + ".lb_v");
+            const bool          has_res = ml.get_tensor_meta((base + ".lb_v_r").c_str()) != nullptr;
+            const int64_t       n_br    = has_res ? 2 : 1;
+
+            llama_littlebit_linear lb;
+            lb.n_in   = n_in;
+            lb.n_out  = n_out;
+            lb.in_pad = meta_v->ne[0];
+            lb.r      = meta_v->ne[1];
+            lb.r_pad  = meta_u->ne[0] / n_br;
+
+            if (meta_u->ne[1] != n_out || meta_u->ne[0] % n_br != 0 || lb.in_pad < n_in || lb.r_pad < lb.r || lb.in_pad > INT32_MAX || lb.r_pad > INT32_MAX/2) {
+                throw std::runtime_error(format("littlebit: inconsistent factor shapes for '%s' (in=%" PRId64 ", out=%" PRId64
+                            ", lb_v=[%" PRId64 ", %" PRId64 "], lb_u=[%" PRId64 ", %" PRId64 "])",
+                            tn.str().c_str(), n_in, n_out, meta_v->ne[0], meta_v->ne[1], meta_u->ne[0], meta_u->ne[1]));
+            }
+
+            for (const char * sfx : { ".lb_v", ".lb_u", ".lb_v_r" }) {
+                const ggml_tensor * meta = ml.get_tensor_meta((base + sfx).c_str());
+                if (meta && meta->type != GGML_TYPE_Q1_0 && meta->type != GGML_TYPE_F16 && meta->type != GGML_TYPE_F32) {
+                    throw std::runtime_error(format("littlebit: unsupported type %s for tensor '%s%s'",
+                                ggml_type_name(meta->type), base.c_str(), sfx));
+                }
+            }
+
+            const LLM_TN_IMPL tn_v2 (tn.arch, tn.tensor, "lb_v2",   tn.bid, tn.xid);
+            const LLM_TN_IMPL tn_v  (tn.arch, tn.tensor, "lb_v",    tn.bid, tn.xid);
+            const LLM_TN_IMPL tn_v2r(tn.arch, tn.tensor, "lb_v2_r", tn.bid, tn.xid);
+            const LLM_TN_IMPL tn_vr (tn.arch, tn.tensor, "lb_v_r",  tn.bid, tn.xid);
+            const LLM_TN_IMPL tn_u  (tn.arch, tn.tensor, "lb_u",    tn.bid, tn.xid);
+
+            const int fl = flags & ~TENSOR_NOT_REQUIRED; // once the factors exist, all of them are required
+            lb.v2 = create(tn_v2, { n_in },              fl);
+            lb.v  = create(tn_v,  { lb.in_pad, lb.r },   fl);
+            if (has_res) {
+                lb.v2_r = create(tn_v2r, { n_in },            fl);
+                lb.v_r  = create(tn_vr,  { lb.in_pad, lb.r }, fl);
+            }
+            lb.u  = create(tn_u, { n_br*lb.r_pad, n_out }, fl);
+
+            if (lb.u == nullptr) {
+                return nullptr; // skipped (e.g. TENSOR_SKIP)
+            }
+
+            ggml_tensor * proxy = littlebit.new_proxy(tn.str().c_str(), n_in, n_out, ml.n_tensors + 16);
+            littlebit.layers.emplace(proxy, lb);
+            return proxy;
+        }
+    }
+
+    return create(tn, ne, flags);
 }
